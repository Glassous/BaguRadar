{
  "id": "/",
  "name": "BaguRadar · 计算机八股文知识库",
  "short_name": "BaguRadar",
  "description": "BaguRadar —— 计算机八股文知识库，覆盖计算机基础、语言运行时、后端中间件、前端、分布式、云原生与 AI 工程。",
  "lang": "zh-CN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "background_color": "#FBFBF9",
  "theme_color": "#FBFBF9",
  "categories": ["education", "productivity"],
